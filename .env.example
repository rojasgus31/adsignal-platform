ADSIGNAL_TARGET_EVENTS=10000000
ADSIGNAL_SEED=20260923
ADSIGNAL_START_DATE=2024-01-01
ADSIGNAL_END_DATE=2025-12-31
ADSIGNAL_DATA_DIR=data
ADSIGNAL_DUCKDB_PATH=data/adsignal.duckdb
# ADSIGNAL_POSTGRES_DSN is intentionally omitted here: under
# `docker compose up`, the pipeline service's `environment:` block always
# sets it to point at the `postgres` service, overriding whatever this file
# says. Set it here only if you run the pipeline outside Docker.

# Comma-separated exact origins allowed to call the API from a browser.
# Empty means no browser may call it. No wildcards.
ADSIGNAL_CORS_ORIGINS=http://localhost:5173

# Proxies in front of the API. 0 for local and direct deployments; 1 on Render.
# Too high lets a caller forge an address and evade the rate limiter.
ADSIGNAL_TRUSTED_PROXY_HOPS=0
